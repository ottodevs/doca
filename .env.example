# RPC endpoint the engine reads pool/strategy state from.
RPC_URL=http://127.0.0.1:8545

# Deployed Aqua registry address for the target chain. TODO: fill in once confirmed at the venue.
AQUA_ADDRESS=0x0000000000000000000000000000000000000000

# Engine loop interval.
LOOP_INTERVAL_MS=15000

# Mainnet (or target chain) RPC used only by the anvil-fork test harness to pin state.
FORK_RPC_URL=

# Uniswap Trading API key (https://developers.uniswap.org/) — used by LP Desk for live Base spot.
UNISWAP_API=

# The Graph Studio — Uniswap v3 Base subgraph history for the PnL chart.
# https://developers.uniswap.org/docs/ecosystem/subgraphs/overview
THE_GRAPH_API_KEY=

# How often to refresh subgraph hourly candles + fork snapshot (ms). Default 1 hour.
SPOT_POLL_MS=3600000

# thirdweb client ID (https://thirdweb.com/dashboard) — powers the wallet sign-in fallback shown
# in the header when the browser has no injected wallet. Client ID only: it is browser-safe by
# design (never the secret key), so the value is documented here rather than left blank.
VITE_THIRDWEB_CLIENT_ID=66df31a0294e6d97110d758e469a8130
